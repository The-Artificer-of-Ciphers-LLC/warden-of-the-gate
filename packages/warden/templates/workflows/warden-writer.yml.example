# EXAMPLE, NOT INSTALLED. The ONE serialized effect path. Runs as the runner's own GITHUB_TOKEN identity (a different identity from the submit token),
# one drain at a time. Triggered by new inbox activity; schedule is intentionally absent (see warden-sweep.yml.example).
name: warden-writer
on:
  issues: { types: [opened, edited] }
  # Runs with this repository's token; safe because no pull request code is checked out and the comment text is read by the CLI, never inlined.
  issue_comment: { types: [created] } # zizmor: ignore[dangerous-triggers]
  workflow_dispatch:
permissions: { contents: read, issues: write }
concurrency: { group: warden-writer, cancel-in-progress: false }
jobs:
  drain:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      # Third-party actions are pinned to a full commit SHA (release tag in the comment), and checkout leaves no token in .git/config.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with: { ref: '${{ github.event.repository.default_branch }}', persist-credentials: false }
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with: { node-version: '26' }
      # The reviewed release-candidate tarball is the pinned artifact here, so there is no lockfile to install from.
      - run: npm install --no-audit --no-fund --ignore-scripts ./vendor/taoc-warden-0.1.0-p4.tgz # zizmor: ignore[adhoc-packages]
      - run: npx warden writer drain --writer-auth actions --submit-auth actions-secret --control-auth actions-secret
        env:
          # Policy is read from this default-branch checkout's commit (PRD §3 trusted base), never from a pull request's head.
          WARDEN_TRUSTED_REF: refs/remotes/origin/${{ github.event.repository.default_branch }}
          GITHUB_TOKEN: ${{ github.token }}
          WARDEN_SUBMIT_TOKEN: ${{ secrets.WARDEN_SUBMIT_TOKEN }}
          WARDEN_CONTROL_READ_TOKEN: ${{ secrets.WARDEN_CONTROL_READ_TOKEN }}
          WARDEN_LEDGER_KEY: ${{ secrets.WARDEN_LEDGER_KEY }}
