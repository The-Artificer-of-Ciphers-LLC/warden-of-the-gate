# EXAMPLE, NOT INSTALLED: copy into .github/workflows/ only after reading it. Scheduling follows ADR 0025: GitHub runs `schedule` triggers
# best effort (they can be hours late, and under load some are dropped), so the primary trigger is `workflow_dispatch`, started on a
# timer by an external scheduler (for the MVP a launchd LaunchAgent running `gh workflow run warden-sweep.yml`; see docs/quickstart.md).
# Sweeps are idempotent, so a late, dropped or duplicate run does no harm and the next run catches up. Never an exact-deadline guarantee.
name: warden-sweep
on:
  workflow_dispatch:
  # Optional backup only, off by default. Nothing relies on when or whether it fires; keep it infrequent and off the top of the hour.
  # schedule:
  #   - cron: '17 */4 * * *'
permissions: { contents: read, issues: write }
concurrency: { group: warden-sweep, cancel-in-progress: false }
jobs:
  sweep:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      # Third-party actions are pinned to a full commit SHA (release tag in the comment), and checkout leaves no token in .git/config.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with: { ref: '${{ github.event.repository.default_branch }}', persist-credentials: false }
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with: { node-version: '26' }
      # The reviewed release-candidate tarball is the pinned artifact here, so there is no lockfile to install from.
      - run: npm install --no-audit --no-fund --ignore-scripts ./vendor/taoc-warden-0.1.0-p4.tgz # zizmor: ignore[adhoc-packages]
      - run: |
          npx warden run --task sweep --submit-auth actions-secret
          npx warden run --task claim --submit-auth actions-secret
        env:
          # Policy is read from this default-branch checkout's commit (PRD §3 trusted base), never from a pull request's head.
          WARDEN_TRUSTED_REF: refs/remotes/origin/${{ github.event.repository.default_branch }}
          WARDEN_SUBMIT_TOKEN: ${{ secrets.WARDEN_SUBMIT_TOKEN }}
