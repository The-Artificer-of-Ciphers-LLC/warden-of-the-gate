{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.invalid/schemas/orders.v1.schema.json",
  "title": "Warden standing orders (.github/ORDERS.yaml), schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "programs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "programs": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "tasks", "decision"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "description": { "type": "string", "maxLength": 500 },
          "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["intake", "triage", "claim", "implement", "review", "rework", "sweep", "retro", "merge"] } },
          "scope": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "kinds": { "type": "array", "items": { "enum": ["bug", "feature", "enhancement", "dependency", "documentation"] } },
              "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "origins": { "type": "array", "items": { "enum": ["contributor", "factory", "automation"] } },
              "maxRisk": { "enum": ["low", "medium"] }
            }
          },
          "exclusions": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "kinds": { "type": "array", "items": { "enum": ["bug", "feature", "enhancement", "dependency", "documentation"] } }
            }
          },
          "decision": { "enum": ["allow", "deny", "require-approval"] },
          "approvalGate": { "enum": ["maintainer"] },
          "escalate": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "decision": { "const": "require-approval" } }, "required": ["decision"] }, "then": { "required": ["approvalGate"] } }
        ]
      }
    }
  }
}
