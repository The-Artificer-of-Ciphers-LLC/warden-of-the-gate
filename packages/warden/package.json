{
  "name": "@taoc/warden",
  "version": "0.1.0-p4",
  "private": true,
  "type": "module",
  "description": "Warden of the Gate: a local-first, one-repository-per-instance software factory CLI (review, triage, housekeeping and gated merge) with a serialized GitHub writer. Release candidate; not published.",
  "license": "MIT",
  "author": "The Artificer of Ciphers LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Artificer-of-Ciphers-LLC/warden-of-the-gate.git",
    "directory": "packages/warden"
  },
  "bugs": {
    "url": "https://github.com/The-Artificer-of-Ciphers-LLC/warden-of-the-gate/issues"
  },
  "homepage": "https://github.com/The-Artificer-of-Ciphers-LLC/warden-of-the-gate#readme",
  "keywords": [
    "warden",
    "software-factory",
    "github",
    "local-llm",
    "opencode",
    "maintainer-tools"
  ],
  "bin": {
    "warden": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "evidence": "node scripts/evidence.ts",
    "prepack": "npm run build",
    "verify-install": "node scripts/verify-install.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.8.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
